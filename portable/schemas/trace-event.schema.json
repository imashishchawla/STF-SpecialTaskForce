{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stf.local/schemas/trace-event.schema.json",
  "title": "STF observed trace event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "task_id", "run_id", "agent_id", "runner_id", "host_id", "adapter_id", "adapter_version", "sequence", "timestamp", "event_type", "status", "policy_version", "policy_decision"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "parent_run_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "runner_id": {"type": "string", "minLength": 1},
    "host_id": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "event_type": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "warning", "error", "unknown"]},
    "capability": {"type": "string"},
    "tool": {"type": "string"},
    "input_ref": {"type": "string"},
    "output_ref": {"type": "string"},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "approval_id": {"type": "string"},
    "policy_version": {"type": "string", "minLength": 1},
    "policy_decision": {"enum": ["allow", "deny", "ask", "not_applicable"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "error_class": {"type": "string"}
  }
}
