{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stf.local/schemas/task.schema.json",
  "title": "STF task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "requested_by", "task_type", "intent", "input", "acceptance_criteria", "requested_capabilities", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "minLength": 1},
    "parent_task_id": {"type": "string", "minLength": 1},
    "requested_by": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "input": {"type": "object"},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requested_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "state": {"enum": ["draft", "ready", "running", "waiting_approval", "paused", "completed", "failed", "cancelled"]},
    "deadline": {"type": "string", "format": "date-time"}
  }
}
