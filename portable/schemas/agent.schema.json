{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stf.local/schemas/agent.schema.json",
  "title": "STF agent request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent_id", "version", "description", "inputs_schema", "outputs_schema", "required_capabilities", "optional_capabilities", "approval_classes", "eval_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "inputs_schema": {"type": "string", "minLength": 1},
    "outputs_schema": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "optional_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "eval_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "max_cost_units": {"type": "number", "minimum": 0}
  }
}
