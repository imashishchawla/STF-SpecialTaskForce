# ==============================================================================
# Master Certification Retrieval & Curation Agent - Environment Configuration
# ==============================================================================

# Search & Crawling APIs
TAVILY_API_KEY=tvly-your-tavily-api-key-here
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key-here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# LLM Provider Configuration
# Supported providers: gemini, anthropic, openai, ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Provider API Keys (Set the one matching your LLM_PROVIDER)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OLLAMA_BASE_URL=http://localhost:11434

# Execution Settings
LOG_LEVEL=INFO
MAX_CRAWL_DEPTH=2
AUTO_PUBLISH_HUGO=false
HUGO_CONTENT_PATH=../../content/credentials
