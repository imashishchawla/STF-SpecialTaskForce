# Terraform Support Agent — .gitignore

# ── Operator configuration (NEVER commit) ───────────────────────────────────
.env
*.env
.env.*
# Track the example file explicitly (it contains no real secrets)
!a2a/.env.example

# ── Live case data (never commit customer or case content) ───────────────────
checkpoints/draft/*.md
!checkpoints/draft/README.md

# ── Generated Bob adapter (regenerated by generate-bob-adapter.sh) ───────────
.bob/skills/

# ── OS and editor artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Vault and audit logs (storage architecture doc 10) ──────────────────────
vault/
audit/
metrics/
messages/
stf.db

# ── A2A optional component ───────────────────────────────────────────────────
a2a/.venv/
a2a/lib/*
!a2a/lib/aicoe-agent-utils
a2a/__pycache__/
a2a/**/__pycache__/
a2a/*.pyc
a2a/a2a-server.log
a2a/.a2a.pid

# ── Python artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Install manifest (generated by installer.sh install) ────────────────────
.install-manifest
