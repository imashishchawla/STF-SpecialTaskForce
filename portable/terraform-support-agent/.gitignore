# Terraform Support Agent — .gitignore

# ── Operator configuration (NEVER commit) ───────────────────────────────────
.env
*.env
.env.*
# Track the example file explicitly (it contains no real secrets)
!a2a/.env.example

# ── Live case data (never commit customer or case content) ───────────────────
checkpoints/draft/*.md
!checkpoints/draft/README.md

# ── Generated Bob adapter (regenerated by generate-bob-adapter.sh) ───────────
.bob/skills/

# ── OS and editor artifacts ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Vault and audit logs (storage architecture doc 10) ──────────────────────
vault/
audit/
metrics/
messages/
stf.db

# ── A2A optional component ───────────────────────────────────────────────────
a2a/.venv/
a2a/lib/*
!a2a/lib/aicoe-agent-utils
a2a/__pycache__/
a2a/**/__pycache__/
a2a/*.pyc
a2a/a2a-server.log
a2a/.a2a.pid

# ── Python artifacts ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# ── Install manifest (generated by installer.sh install) ────────────────────
.install-manifest
.install-manifest.txt

# Local onboarding and case state. Ignore rules do not untrack existing files.
/memory/preferences.md
/checkpoints/**
!/checkpoints/README.md
!/checkpoints/draft/
!/checkpoints/draft/README.md
/evals/results/*
!/evals/results/.gitkeep
stf.db-*

# Release output if the operator selects a directory within this agent.
terraform-support-agent-*.tar.gz
terraform-support-agent-*.tar.gz.sig
terraform-support-agent-*.tar.gz.sha256

# Personal and case-derived memory is runtime state, not distributable source.
# Previously tracked entries still require a curated export or index cleanup.
/memory/**
/checkpoints/**
/audit/**
/metrics/**
/messages/**
/.trace/
/.history/
/.checkpoints/
*.log
*.pid
*.bak
*.tmp
/.bob/custom_modes.yaml
/release-output/
