# Terraform Support Agent — A2A server environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported: watsonx | ollama
LLM_PROVIDER=watsonx

# WatsonX settings (required when LLM_PROVIDER=watsonx)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=meta-llama/llama-3-3-70b-instruct

# Ollama settings (required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3

# ── A2A server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Auth (disabled by default for Phase 3b local use) ─────────────────────────
ENABLE_CLIENT_AUTH=false
ENABLE_USER_AUTH=false

# ── MCP tool servers (none wired in Phase 3b — all Phase 4) ───────────────────
# MCP_TERRAFORM_URL=http://localhost:9001

# ── AgentOps (optional — install aicoe-agent-utils[agentops] to enable) ───────
AGENTOPS_API_KEY=
